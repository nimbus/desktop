{
  "name": "@nimbus/desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Nimbus <ops@nimbus.dev>",
  "description": "Native desktop shell for the Nimbus operator console.",
  "desktopName": "nimbus-desktop",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "lint": "biome check src tests scripts",
    "format": "biome format --write src tests scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:main": "tsc -p tsconfig.build.json",
    "dev": "npm run build:main && electron dist/main/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:secrets": "bash scripts/verify-secrets.sh",
    "verify:ds1": "npm run build:main && node scripts/ds1-browser-probe.mjs",
    "verify:ds2": "npm run build:main && node scripts/ds2-browser-probe.mjs",
    "package": "npm run build:main && electron-builder --dir",
    "package:mac": "npm run build:main && electron-builder --mac --publish=never",
    "package:win": "npm run build:main && electron-builder --win --publish=never",
    "package:linux": "npm run build:main && electron-builder --linux --publish=never",
    "verify:fuses": "node scripts/ds3-verify-fuses.mjs",
    "verify:ds3": "npm run package && node scripts/ds3-verify-fuses.mjs && node scripts/ds3-browser-probe.mjs",
    "verify:ds4": "npm run build:main && node scripts/ds4-bounds-probe.mjs",
    "verify:ds5": "npm run build:main && node scripts/ds5-updater-probe.mjs",
    "verify:installers": "node scripts/check-installer-sizes.cjs",
    "verify:ds6": "npm run package:mac && node scripts/prepublish-check.cjs release/mac-universal/nimbus-desktop.app/Contents/MacOS/nimbus-desktop && node scripts/check-installer-sizes.cjs release",
    "clean": "rm -rf dist release"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@electron/fuses": "2.1.1",
    "@electron/notarize": "3.1.0",
    "@playwright/test": "1.60.0",
    "@types/node": "22.20.1",
    "electron": "42.10.1",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
